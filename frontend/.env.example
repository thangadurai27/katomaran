# All VITE_* values are read at BUILD time by Vite.
# They are only needed for non-default deployments — frontend/src/config/env.js
# already falls back to the production Render backend when unset in prod builds,
# and to localhost:5000 in dev.

# Backend REST API base (must include /api)
#VITE_API_URL=http://localhost:5000/api

# Backend base URL (used for socket.io and absolute asset URLs)
#VITE_BASE_URL=http://localhost:5000

# Base for displaying/copying short links (must end with /r/)
#VITE_SHORT_URL_BASE=http://localhost:5000/r/
