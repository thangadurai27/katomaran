# ---- Server ----
# Render injects PORT automatically; locally 5000 is the convention
# (frontend dev proxy + fallback in frontend/src/config/env.js expect it)
PORT=5000
NODE_ENV=development

# ---- Database (required) ----
# MongoDB Atlas connection string. URL-encode special chars in the password
# (@ -> %40, # -> %23). Keep the full SRV host.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<dbname>?retryWrites=true&w=majority
# Optional: override the database name inside the URI
MONGODB_DB_NAME=

# ---- JWT (required) ----
# Two different secrets: access token + refresh token
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
# Access token lifetime (default 15m) / refresh token lifetime (default 7d)
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ---- CORS (required in production) ----
# Exact origin(s) of the frontend, comma-separated, no trailing slashes.
# Used by utils/corsOrigins.js — cookies only work for whitelisted origins.
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ---- Short URL base ----
# Base used when rendering shortUrl / QR targets (no trailing slash issues:
# must end with /r/)
SHORT_URL_BASE=http://localhost:5000/r/

# ---- Google Gemini AI (optional) ----
# https://aistudio.google.com/apikey — AI features degrade gracefully if unset
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Email (optional) ----
# Without these, email verification / password-reset emails are skipped and
# verification links are logged instead (SMTP, e.g. Gmail app password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="SnapLink AI <no-reply@yourdomain.com>"

# ---- Security tuning (optional) ----
# bcrypt cost factor (default 10)
BCRYPT_ROUNDS=10
